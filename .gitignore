# Compiled files
*.o
*.so
*.rlib
*.dll
*.fd

# Executables
*.exe

# Generated by Cargo
target/

# Build directory
build/

# Generated documentation, used for GitHub Pages
github_pages/book/
github_pages/doc/

# patched GDB directory
/rust-os-gdb/

# Theseus's local build server
.theseus_build_server/

# IDE files
*.idea/
*.vscode/
*.code-workspace
*.swp

# log files
*.pcap
*.out
*.log

# Fichiers générés : pas de binaires dans git, les scripts les recréent.
# Disque de test : tools/create_disk.{sh,ps1}
/fat32.img
# Doom relié et copie du WAD : scripts/rebuild_all.sh
/extra_files/doom.elf
/extra_files/DOOM1.WAD
/userland/ports/doom/doom.elf
# Binaires Linux de test (musl, BusyBox) : userland/tests/linux_abi/build.sh
/extra_files/linux/
# Archive d'origine du shareware : assets/DOOM1.WAD suffit
/assets/*.zip
*.bak

# limine bootloader files
/tools/limine/bin/

# library lock files
/libs/**/Cargo.lock

# macOS directory stores
/**/.DS_Store
.claude/
